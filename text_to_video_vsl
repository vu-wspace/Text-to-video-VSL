))\n    writer = cv2.VideoWriter(output_path, cv2.VideoWriter_fourcc(*'mp4v'), fps, (width, height))\n\n    frame_idx = 0\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        frame_data = cached_frames[frame_idx] if frame_idx < len(cached_frames) else None\n        writer.write(draw_keypoints_on_frame(frame, frame_data))\n        frame_idx += 1\n\n    cap.release()\n    writer.release()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T22:24:22.346389Z","iopub.execute_input":"2026-09-09T22:24:22.34735Z","iopub.status.idle":"2026-09-09T22:24:22.354272Z","shell.execute_reply.started":"2026-09-09T22:24:22.347306Z","shell.execute_reply":"2026-09-09T22:24:22.353328Z"}},"outputs":[],"execution_count":58},{"cell_type":"code","source":"skeleton_video_demo_1(\n    video_path=os.path.join(VIDEO_FOLDER, f'D0001B{VIDEO_EXT}'),\n    json_path='/kaggle/working/QiPedVSL_Keypoints/D0001B.json',\n    output_path='/kaggle/working/D0001B_overlay.mp4'\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T22:24:23.123179Z","iopub.execute_input":"2026-09-09T22:24:23.123489Z","iopub.status.idle":"2026-09-09T22:24:24.472964Z","shell.execute_reply.started":"2026-09-09T22:24:23.123459Z","shell.execute_reply":"2026-09-09T22:24:24.472036Z"}},"outputs":[],"execution_count":59},{"cell_type":"code","source":"Video('/kaggle/working/D0001B_overlay.mp4', embed=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T22:24:24.474594Z","iopub.execute_input":"2026-09-09T22:24:24.47528Z","iopub.status.idle":"2026-09-09T22:24:24.502825Z","shell.execute_reply.started":"2026-09-09T22:24:24.475244Z","shell.execute_reply":"2026-09-09T22:24:24.501584Z"}},"outputs":[{"execution_count":60,"output_type":"execute_result","data":{"text/plain":"<IPython.core.display.Video object>","text/html":"<video controls  >\n <source src=\"data:video/mp4;base64,\" type=\"video/mp4\">\n Your browser does not support 