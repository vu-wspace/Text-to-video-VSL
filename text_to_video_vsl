026-09-08T18:53:44.230286Z","iopub.execute_input":"2026-09-08T18:53:44.230549Z","iopub.status.idle":"2026-09-08T18:53:44.252Z","shell.execute_reply.started":"2026-09-08T18:53:44.230525Z","shell.execute_reply":"2026-09-08T18:53:44.250715Z"}},"outputs":[],"execution_count":48},{"cell_type":"code","source":"# all_ids = df['ID_video'].unique().tolist()\n\n# skeleton_video_folder(\n#     video_folder=VIDEO_FOLDER,\n#     video_ext=VIDEO_EXT,\n#     skeleton_folder=SKELETON_VIDEO_FOLDER,\n#     id_videos=all_ids,\n# )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T18:53:44.253151Z","iopub.execute_input":"2026-09-08T18:53:44.253418Z","iopub.status.idle":"2026-09-08T18:53:44.284941Z","shell.execute_reply.started":"2026-09-08T18:53:44.253392Z","shell.execute_reply":"2026-09-08T18:53:44.283366Z"}},"outputs":[],"execution_count":49},{"cell_type":"markdown","source":"# Gloss–Skeleton Dictionary 2","metadata":{}},{"cell_type":"code","source":"def extract_keypoints(input_path: str) -> list:\n    cap = cv2.VideoCapture(input_path)\n    if not cap.isOpened():\n        return None\n    frames_data = []\n    with mp_holistic.Holistic(static_image_mode=False, model_complexity=1,\n                               min_detection_confidence=0.5, min_tracking_confidence=0.5) as holistic:\n        while True:\n            ret, frame = cap.read()\n            if not ret:\n                break\n            results = holistic.process(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))\n\n            def to_list(lms):\n                return None if lms is None else [{\"x\": p.x, \"y\": p.y, \"z\": p.z} for p in lms.landmark]\n\n            frames_data.append({\n                \"pose\": to_list(results.pose_landmarks),\n                \"face\": to_list(results.face_landmarks),\n                \"left_hand\": to_list(results.left_hand_landmarks),\n                \"right_hand\": to_list(results.right_hand_landmarks),\n            })\n    cap.release()\n    return frames_data","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T18:53:44.286271Z","iopub.execute_input":"2026-09-08T18:53:44.286618Z","iopub.status.idle":"2026-09-08T18:53:44.312492Z","shell.execute_reply.started":"2026-09-08T18:53:44.286591Z","shell.execute_reply":"2026-09-08T18:53:44.311411Z"}},"outputs":[],"execution_count":50},{"cell_type":"code","source":"def build_skeleton_keypoints_folder(video_folder, video_ext, keypoints_folder, id_videos,\n                                     log_path='keypoints_build_log.json'):\n    os.makedirs(keypoints_folder, exist_ok=True)\n    done, skipped, failed = [], [], []\n    t0 = time.time()\n    for idx, vid in enumerate(id_videos, 1):\n        out_path = os.path.join(keypoints_folder, f'{vid}.json')\n        in_path = os.path.join(video_folder, f'{vid}{video_ext}')\n        if os.path.exists(out_path):\n            skipped.append(vid); continue\n        if not os.path.exists(in_path):\n            failed.append({'id': vid, 'reason': 'input_not_found'}); continue\n        try:\n            data = extract_keypoints(in_path)\n            if data is None:\n                failed.append({'id': vid, 'reason': 'read_failed'})\n            else:\n                with open(out_path, 'w', encoding='utf-8') as f:\n                    json.dump(data, f)\n                done.append(vid)\n        except Exception as e:\n            failed.append({'id': vid, 'reason': str(e)})\n        if idx % 50 == 0 or idx == len(id_videos):\n            elapsed = time.time() - t0\n            print(f'[{idx}/{len(id_videos)}] xong={len(done)} bỏ_qua={len(skipped)} lỗi={len(failed)} '\n                  f'({elapsed:.1f}s, ~{elapsed/idx:.2f}s/video)', flush=True)\n    with open(log_path, 'w', encoding='utf-8') as f:\n        json.dump({'done': done, 'skipped': skipped, 'failed': failed}, f, ensure_ascii=False, indent=2)\n    print(f'\\nHOÀN TẤT: {len(done)} mới, {len(skipped)} đã có sẵn, {len(failed)} lỗi.')\n    return done, skipped, failed","meta