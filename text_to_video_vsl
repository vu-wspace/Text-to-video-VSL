),\n        ('right_hand', (0, 0, 255)),\n    ]\n    for part_key, color in part_colors:\n        pts = frame_data.get(part_key)\n        if pts:\n            radius = 1 if part_key == 'face' else 3\n            for p in pts:\n                cv2.circle(out, (int(p['x'] * w), int(p['y'] * h)), radius, color, -1)\n    return out","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T22:24:20.107852Z","iopub.execute_input":"2026-09-09T22:24:20.108238Z","iopub.status.idle":"2026-09-09T22:24:20.115188Z","shell.execute_reply.started":"2026-09-09T22:24:20.108207Z","shell.execute_reply":"2026-09-09T22:24:20.114209Z"}},"outputs":[],"execution_count":57},{"cell_type":"markdown","source":"## Video demo 1: chỉ demo 1 video duy nhất","metadata":{}},{"cell_type":"code","source":"def skeleton_video_demo_1(video_path: str, json_path: str, output_path: str):\n    with open(json_path, encoding='utf-8') as f:\n        cached_frames = json.load(f)\n\n    cap = cv2.VideoCapture(video_path)\n    fps = cap.get(cv2.CAP_PROP_FPS) or 25\n    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n    writer = cv2.VideoWriter(output_path, cv2.VideoWriter_fourcc(*'mp4v'), fps, (width, height))\n\n    frame_idx = 0\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        frame_data = cached_frames[frame_idx] if frame_idx < len(cached_frames) else None\n        writer.write(draw_keypoints_on_frame(frame, frame_data))\n        frame_idx += 1\n\n    cap.release()\n    writer.release()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T22:24:22.346389Z","iopub.execute_input":"2026-09-09T22:24:22.34735Z","iopub.status.idle":"2026-09-09T22:24:22.354272Z","shell.execute_reply.started":"2026-09-09T22:24:22.347306Z","shell.execute_reply":"2026-09-09T22:24:22.353328Z"}},"outputs":[],"execution_count":58},{"cell_type":"code","source":"skeleton_video_demo_1(\n    video_path=os.pa